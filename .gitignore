# Publish the portable single-arm workflow only.
/*
!/.gitignore
!/README.md
!/requirements-pick.txt
!/requirements-pick-core.txt
!/requirements-transfer.txt
!/tools/
!/docs/
!/config/
!/weights/

/tools/**
!/tools/measurement/
!/tools/picking/
!/tools/measurement/*.py
!/tools/picking/*.py

/docs/*
!/docs/omx_second_laptop_runbook.md

/config/*
!/config/omx_pick.example.json

/weights/*
!/weights/best.pt
!/weights/classes.txt

**/__pycache__/
*.py[cod]
.env
.env.*
*.pem
*.key

# Runtime behavior documentation.
!/docs/omx_parking.md
!/docs/omx_wrist_direction_fix.md

# Portable offline tests and synthetic fixtures.
!/tests/
/tests/**
!/tests/*.py
!/tests/fixtures/
!/tests/fixtures/*.json
